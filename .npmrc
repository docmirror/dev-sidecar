registry=https://registry.npmmirror.com
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron
# Native modules (e.g. @parcel/watcher) require C++17.
# In CI, CXXFLAGS=-std=c++17 (Linux/macOS) and CL=/std:c++17 (Windows) are
# set before `pnpm install` so node-gyp compiles with the correct standard.
# For local builds on Linux/macOS set it in your shell:
#   export CXXFLAGS="-std=c++17"
# For local builds on Windows set in your shell:
#   set CL=/std:c++17

# electron-builder 无法可靠处理 pnpm 的软链布局（依赖在本地能解析但打进 asar 会丢，症状：启动报 Cannot find module）。# 改为扁平链接，使 node_modules 下为实体目录。# 放在 .npmrc 而非 pnpm-workspace.yaml：CI 的 node_modules 来自旧缓存恢复，# 若 nodeLinker 写在 workspace 里会被旧安装遗留的 .modules.yaml（hoistedLayout=false）钉死；# .npmrc 每次 pnpm install 前被重写，保证生效。node-linker=hoisted
