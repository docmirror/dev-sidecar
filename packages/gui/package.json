{
  "name": "@docmirror/dev-sidecar-gui",
  "version": "2.3.2",
  "private": false,
  "type": "module",
  "main": "src/background.js",
  "author": {
    "email": "xiaojunnuo@qq.com",
    "name": "Greper"
  },
  "description": "开发者边车辅助工具 — 加速 GitHub/NPM/Docker Hub 等站点的本地 MITM 代理",
  "license": "MPL-2.0",
  "homepage": "https://github.com/docmirror/dev-sidecar",
  "scripts": {
    "gen:tray-plugins": "node scripts/gen-tray-plugins.mjs",
    "serve": "pnpm exec vue-cli-service serve",
    "prebuild": "node scripts/gen-tray-plugins.mjs && node scripts/gen-kernel-info.mjs && node ../../_script/sync-official-config.mjs",
    "build": "pnpm exec vue-cli-service build",
    "lint": "pnpm exec vue-cli-service lint",
    "preelectron": "node scripts/gen-tray-plugins.mjs && node scripts/gen-kernel-info.mjs",
    "electron": "node ../../_script/electron-dev.mjs",
    "electron:build": "node scripts/local-build-version.mjs",
    "electron:build:ci": "npm run build && npm exec electron-builder -- --config electron-builder.config.cjs",
    "version:local": "node scripts/local-build-version.mjs --print",
    "postinstall": "node -e \"if (!process.env.CI) { try { require('node:child_process').execFileSync(process.execPath, ['node_modules/electron-builder/cli.js', 'install-app-deps'], { stdio: 'inherit' }) } catch (e) { console.warn('[postinstall] install-app-deps 失败，已跳过（可手动重跑）:', e.message) } }\"",
    "postuninstall": "pnpm exec electron-builder install-app-deps",
    "gen:kernel-info": "node scripts/gen-kernel-info.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@blue-frontier/dev-sidecar": "workspace:*",
    "@blue-frontier/mitmproxy": "workspace:*",
    "@starknt/shutdown-handler-napi": "^0.0.3",
    "@starknt/shutdown-handler-napi-win32-x64-msvc": "^0.0.3",
    "@starknt/sysproxy": "^0.0.3",
    "@starknt/sysproxy-win32-x64-msvc": "^0.0.3",
    "@vscode/sudo-prompt": "^9.3.2",
    "adm-zip": "^0.5.18",
    "ant-design-vue": "^4.2.6",
    "archiver": "^7.0.1",
    "core-js": "^3.51.0",
    "electron-baidu-tongji": "^1.0.5",
    "electron-updater": "^6.8.9",
    "json5": "^2.2.3",
    "jsoneditor": "^10.4.3",
    "lodash": "^4.18.1",
    "minimist": "^1.2.8",
    "request": "^2.88.2",
    "request-progress": "^3.0.0",
    "sass": "^1.106.0",
    "sass-loader": "^16.0.8",
    "tiny-emitter": "^2.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@vue/babel-helper-vue-jsx-merge-props": "^1.4.0",
    "@vue/babel-preset-jsx": "^1.4.0",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.11.16",
    "electron-builder": "26.17.0",
    "electron-builder-squirrel-windows": "26.17.0",
    "json5-loader": "^4.0.1",
    "path-browserify": "^1.0.1",
    "wait-on": "^7.2.0",
    "webpack": "5.106.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
